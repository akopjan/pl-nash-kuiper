PLGeometry.akopyan_pl_nash_kuiper (κ : PLGeometry.Geometry) {d m n : ℕ} (hdn : d ≤ n) (K : PLGeometry.Polyhedron κ d m)
  (f : ↑K.K.space → PLGeometry.Model κ n) (hf : PLGeometry.Lipschitz K f 1)
  (hsphere :
    κ = PLGeometry.Geometry.spherical →
      (∃ L < 1, PLGeometry.Lipschitz K f L) ∨ ∃ o, ∀ (x : ↑K.K.space), PLGeometry.modelDist κ n (f x) o < Real.pi / 2)
  {ε : ℝ} (hε : 0 < ε) : ∃ g, PLGeometry.PLIsometry K g ∧ ∀ (x : ↑K.K.space), PLGeometry.modelDist κ n (g x) (f x) < ε
'PLGeometry.akopyan_pl_nash_kuiper' depends on axioms: [propext, Classical.choice, Quot.sound]
