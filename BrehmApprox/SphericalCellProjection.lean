module

public import BrehmApprox.SphericalProjection
public import BrehmApprox.SphericalPolytopeNeighborhoods

/-!
# Actual spherical-cell nearest projections and polyhedral collars

The Euclidean cone generated by a finite hemispherical vertex set is proved
closed, and its unit section is exactly `sphericalCell V`.  Thus the projection
estimates apply to the concrete cells already used in the PL predicates.
-/

@[expose] public section

noncomputable section

open scoped BigOperators

namespace BrehmApprox

open GeodesicSphere

variable {n : ℕ}

/-- The cone of nonnegative finite combinations of spherical vertices. -/
def vertexCone (V : Finset (GeodesicSphere n)) :
    PointedCone ℝ (EuclideanSpace ℝ (Fin (n + 1))) where
  carrier := {z | ∃ w : GeodesicSphere n → ℝ, (∀ v ∈ V, 0 ≤ w v) ∧
    ∑ v ∈ V, w v • v.val = z}
  zero_mem' := ⟨fun _ => 0, by simp, by simp⟩
  add_mem' := by
    rintro x y ⟨w, hw, hsumw⟩ ⟨u, hu, hsumu⟩
    refine ⟨fun v => w v + u v, fun v hv => add_nonneg (hw v hv) (hu v hv), ?_⟩
    simp only [add_smul, Finset.sum_add_distrib, hsumw, hsumu]
  smul_mem' := by
    intro c x hx
    obtain ⟨w, hw, hsum⟩ := hx
    refine ⟨fun v => c.val * w v, fun v hv => mul_nonneg c.property (hw v hv), ?_⟩
    change (∑ v ∈ V, (c.val * w v) • v.val) = c.val • x
    simp only [mul_smul, ← Finset.smul_sum, hsum]

lemma mem_vertexCone_unit_iff (V : Finset (GeodesicSphere n)) (x : GeodesicSphere n) :
    x.val ∈ vertexCone V ↔ x ∈ sphericalCell V := by
  constructor
  · rintro ⟨w, hw, hsum⟩
    exact ⟨w, hw, 1, zero_lt_one, by simpa using hsum⟩
  · rintro ⟨w, hw, a, ha, hsum⟩
    refine ⟨fun v => a⁻¹ * w v, fun v hv => mul_nonneg (inv_nonneg.mpr ha.le) (hw v hv), ?_⟩
    simp only [mul_smul, ← Finset.smul_sum, hsum]
    rw [smul_smul, inv_mul_cancel₀ ha.ne', one_smul]

lemma mem_vertexCone_iff_normalize (V : Finset (GeodesicSphere n))
    (z : EuclideanSpace ℝ (Fin (n + 1))) (hz : z ≠ 0) :
    z ∈ vertexCone V ↔ normalizeVector z hz ∈ sphericalCell V := by
  constructor
  · intro hzC
    apply (mem_vertexCone_unit_iff V _).mp
    change ‖z‖⁻¹ • z ∈ vertexCone V
    exact (vertexCone V).smul_mem (inv_nonneg.mpr (norm_nonneg z)) hzC
  · intro hzC
    have hunit := (mem_vertexCone_unit_iff V _).mpr hzC
    have hscale := (vertexCone V).smul_mem (norm_nonneg z) hunit
    simpa only [normalizeVector_val, NormedSpace.norm_smul_normalize] using hscale

/-- A finite cone generated inside an open hemisphere is closed.  The proof
uses the already proved closedness of its unit spherical section. -/
theorem isClosed_vertexCone (V : Finset (GeodesicSphere n)) (hV : InOpenHemisphere V) :
    IsClosed (vertexCone V : Set (EuclideanSpace ℝ (Fin (n + 1)))) := by
  let D : Set (EuclideanSpace ℝ (Fin (n + 1))) := {z | z ≠ 0}
  let N : D → GeodesicSphere n := fun z => normalizeVector z.val z.property
  have hD : IsOpen D := isOpen_ne
  have hN : Continuous N := continuous_normalizeVector Subtype.val continuous_subtype_val
    (fun z => z.property)
  have hO : IsOpen (N ⁻¹' (sphericalCell V)ᶜ) :=
    (isClosed_sphericalCell V hV).isOpen_compl.preimage hN
  have heq : (vertexCone V : Set (EuclideanSpace ℝ (Fin (n + 1))))ᶜ =
      Subtype.val '' (N ⁻¹' (sphericalCell V)ᶜ) := by
    apply Set.Subset.antisymm
    · intro z hzC
      have hz : z ≠ 0 := by
        intro hz
        subst z
        exact hzC (vertexCone V).zero_mem
      refine ⟨⟨z, hz⟩, ?_, rfl⟩
      change normalizeVector z hz ∉ sphericalCell V
      intro hnorm
      exact hzC ((mem_vertexCone_iff_normalize V z hz).mpr hnorm)
    · rintro _ ⟨z, hzC, rfl⟩
      change z.val ∉ vertexCone V
      intro hz
      exact hzC ((mem_vertexCone_iff_normalize V z.val z.property).mp hz)
  rw [← isOpen_compl_iff, heq]
  exact hD.isOpenMap_subtype_val _ hO

/-- The actual closed convex cone whose spherical section is the given cell. -/
def sphericalCellCone (V : Finset (GeodesicSphere n)) (hV : InOpenHemisphere V) :
    ProperCone ℝ (EuclideanSpace ℝ (Fin (n + 1))) where
  toSubmodule := vertexCone V
  isClosed' := isClosed_vertexCone V hV

@[simp]
lemma coneSection_sphericalCellCone (V : Finset (GeodesicSphere n)) (hV : InOpenHemisphere V) :
    coneSection (sphericalCellCone V hV) = sphericalCell V := by
  ext x
  exact mem_vertexCone_unit_iff V x

/-- Concrete nearest-point projection to a finite spherical cell on its
hemispherical neighborhood, with harmless totalization away from that domain. -/
def sphericalCellProjection (V : Finset (GeodesicSphere n)) (hV : InOpenHemisphere V) :
    GeodesicSphere n → GeodesicSphere n :=
  sphericalConeProjection (sphericalCellCone V hV)

lemma sphericalCellProjection_fix (V : Finset (GeodesicSphere n)) (hV : InOpenHemisphere V)
    {x : GeodesicSphere n} (hx : x ∈ sphericalCell V) : sphericalCellProjection V hV x = x := by
  apply sphericalConeProjection_fix
  simpa only [coneSection_sphericalCellCone] using hx

/-- A genuine polyhedral collar carrying the proved nearly nonexpansive
nearest-point projection to the original spherical cell. -/
theorem exists_spherical_projection_collar (V : Finset (GeodesicSphere n))
    (hV : InOpenHemisphere V) {ℓ r : ℝ}
    (hℓ0 : 0 < ℓ) (hℓπ : ℓ < Real.pi) (hr0 : 0 < r) (hrπ : r < Real.pi / 2)
    (hdiam : ∀ v ∈ sphericalCell V, ∀ w ∈ sphericalCell V, dist v w ≤ ℓ) :
    ∃ W : Finset (GeodesicSphere n), InOpenHemisphere W ∧
      sphericalCell V ⊆ interior (sphericalCell W) ∧
      (∀ x ∈ sphericalCell W, sphericalCellProjection V hV x ∈ sphericalCell V) ∧
      (∀ x ∈ sphericalCell W, ∀ y ∈ sphericalCell W,
        dist (sphericalCellProjection V hV x) (sphericalCellProjection V hV y) ≤
          sphericalProjectionFactor ℓ r * dist x y) := by
  let U : Set (GeodesicSphere n) := ⋃ v ∈ sphericalCell V, Metric.ball v r
  have hU : IsOpen U := isOpen_iUnion fun _ => isOpen_iUnion fun _ => Metric.isOpen_ball
  have hVU : sphericalCell V ⊆ U := by
    intro v hv
    exact Set.mem_iUnion₂.mpr ⟨v, hv, by simpa using hr0⟩
  obtain ⟨W, hW, hVW, hWU⟩ := exists_sphericalCell_neighborhood V hV hU hVU
  have htube : ∀ x ∈ sphericalCell W, x ∈ coneTube (sphericalCellCone V hV) r := by
    intro x hx
    obtain ⟨v, hv, hdist⟩ := Set.mem_iUnion₂.mp (hWU hx)
    exact ⟨v, by simpa only [coneSection_sphericalCellCone] using hv, hdist.le⟩
  refine ⟨W, hW, hVW, ?_, ?_⟩
  · intro x hx
    have hnonzero := coneProjection_ne_zero_on_tube (sphericalCellCone V hV) hr0.le hrπ (htube x hx)
    have hmem := sphericalConeProjection_mem (sphericalCellCone V hV) x hnonzero
    change sphericalConeProjection (sphericalCellCone V hV) x ∈ sphericalCell V
    simpa only [coneSection_sphericalCellCone] using hmem
  · intro x hx y hy
    apply sphericalConeProjection_lipschitz (sphericalCellCone V hV) hℓ0 hℓπ hr0.le hrπ
      ?_ (htube x hx) (htube y hy)
    simpa only [coneSection_sphericalCellCone] using hdiam

end BrehmApprox
