module

public import BrehmApprox.ChainRemetricization

/-!
# Intrinsic chain metric on an injectively embedded connected cell cover

The ambient metric only provides the costs of links and separates points.
The constructed metric is the infimum of actual finite cell-chain costs.
No intrinsicness assumption on the ambient subspace metric is made. A common
centre in all cells is one elementary sufficient condition for connectivity.
-/

@[expose] public section
noncomputable section

namespace BrehmApprox.ConnectedCellMetric

universe u v w z

variable {P : Type u} {ι : Type v} {E : Type w} [MetricSpace E]
variable {cell : ι → Set P} {q : P → E}

def Connected (cell : ι → Set P) : Prop :=
  ∀ x y : P, Nonempty (CellChain cell x y)

theorem connected_of_common_center (m : P)
    (hcover : ∀ x : P, ∃ i, x ∈ cell i)
    (hm : ∀ i, m ∈ cell i) : Connected cell := by
  intro x y
  obtain ⟨i, hi⟩ := hcover x
  obtain ⟨j, hj⟩ := hcover y
  exact ⟨(CellChain.single i hi (hm i)).append (CellChain.single j (hm j) hj)⟩

variable (hc : Connected cell)

include hc in
theorem costs_nonempty (x y : P) :
    ({r : ℝ | ∃ a : CellChain cell x y, a.cost q = r} : Set ℝ).Nonempty := by
  obtain ⟨a⟩ := hc x y
  exact ⟨a.cost q, a, rfl⟩

include hc in
theorem nonneg (x y : P) : 0 ≤ chartChainDist cell q x y := by
  apply le_csInf (costs_nonempty hc x y)
  rintro r ⟨a, rfl⟩
  exact a.cost_nonneg q

theorem le_cost {x y : P} (a : CellChain cell x y) :
    chartChainDist cell q x y ≤ a.cost q := ChartChainDist.le_cost a

include hc in
theorem approx (x y : P) {ε : ℝ} (hε : 0 < ε) :
    ∃ a : CellChain cell x y, a.cost q < chartChainDist cell q x y + ε := by
  obtain ⟨r, ⟨a, rfl⟩, hr⟩ := exists_lt_of_csInf_lt (costs_nonempty hc (q := q) x y)
    (lt_add_of_pos_right (chartChainDist cell q x y) hε)
  exact ⟨a, hr⟩

include hc in
theorem self (x : P) : chartChainDist cell q x x = 0 :=
  le_antisymm (by simpa using le_cost (q := q) (.nil x)) (nonneg hc x x)

include hc in
theorem comm (x y : P) : chartChainDist cell q x y = chartChainDist cell q y x := by
  apply le_antisymm
  · apply le_csInf (costs_nonempty hc y x)
    rintro r ⟨a, rfl⟩
    simpa using le_cost (q := q) a.reverse
  · apply le_csInf (costs_nonempty hc x y)
    rintro r ⟨a, rfl⟩
    simpa using le_cost (q := q) a.reverse

include hc in
theorem triangle (x y z : P) :
    chartChainDist cell q x z ≤ chartChainDist cell q x y + chartChainDist cell q y z := by
  by_contra hnot
  have hgap : 0 < chartChainDist cell q x z -
      (chartChainDist cell q x y + chartChainDist cell q y z) := by linarith
  obtain ⟨a, ha⟩ := approx hc (q := q) x y (show 0 <
    (chartChainDist cell q x z - (chartChainDist cell q x y + chartChainDist cell q y z)) / 3 by linarith)
  obtain ⟨b, hb⟩ := approx hc (q := q) y z (show 0 <
    (chartChainDist cell q x z - (chartChainDist cell q x y + chartChainDist cell q y z)) / 3 by linarith)
  have hh := le_cost (q := q) (a.append b)
  rw [CellChain.cost_append] at hh
  linarith

include hc in
theorem ambient_le (x y : P) : dist (q x) (q y) ≤ chartChainDist cell q x y := by
  apply le_csInf (costs_nonempty hc x y)
  rintro r ⟨a, rfl⟩
  exact a.dist_le_cost q

include hc in
theorem on_cell (i : ι) {x y : P} (hx : x ∈ cell i) (hy : y ∈ cell i) :
    chartChainDist cell q x y = dist (q x) (q y) := by
  apply le_antisymm
  · simpa using le_cost (q := q) (CellChain.single i hx hy)
  · exact ambient_le hc x y

/-- The actual intrinsic metric. Its topology is constructed from the chain
distance, rather than postulated equal to the ambient topology. -/
@[instance_reducible]
def metricSpace (hq : Function.Injective q) : MetricSpace P where
  dist := chartChainDist cell q
  dist_self := self hc
  dist_comm := comm hc
  dist_triangle := triangle hc
  eq_of_dist_eq_zero := by
    intro x y hxy
    apply hq
    apply eq_of_dist_eq_zero
    have h := ambient_le hc (q := q) x y
    rw [hxy] at h
    exact le_antisymm h dist_nonneg

/-- The new metric is generated by the displayed cells. -/
theorem intrinsic (hq : Function.Injective q) :
    @ChainGenerated P (metricSpace hc hq) ι cell := by
  intro x y ε hε
  obtain ⟨a, ha⟩ := approx hc (q := q) x y hε
  obtain ⟨n, z, h0, hn, hcells, hcost⟩ := a.exists_sequence q
  refine ⟨n, z, h0, hn, hcells, ?_⟩
  change (∑ j ∈ Finset.range n, chartChainDist cell q (z j) (z (j + 1))) <
    chartChainDist cell q x y + ε
  have heq : (∑ j ∈ Finset.range n, chartChainDist cell q (z j) (z (j + 1))) = a.cost q := by
    rw [← hcost]
    apply Finset.sum_congr rfl
    intro j hj
    obtain ⟨i, hi, hj'⟩ := hcells j (Finset.mem_range.mp hj)
    exact on_cell hc i hi hj'
  rwa [heq]

theorem lipschitzWith_of_cellwise {Y : Type z} [MetricSpace Y]
    (hq : Function.Injective q) {f : P → Y} {L : NNReal}
    (hlocal : ∀ i, ∀ x ∈ cell i, ∀ y ∈ cell i,
      dist (f x) (f y) ≤ L * dist (q x) (q y)) :
    let : MetricSpace P := metricSpace hc hq
    LipschitzWith L f := by
  let : MetricSpace P := metricSpace hc hq
  apply BrehmApprox.lipschitzWith_of_cellwise (intrinsic hc hq)
  intro i x hx y hy
  change dist (f x) (f y) ≤ L * chartChainDist cell q x y
  rw [on_cell hc i hx hy]
  exact hlocal i x hx y hy

theorem ambient_lipschitz (hq : Function.Injective q) :
    let : MetricSpace P := metricSpace hc hq
    LipschitzWith 1 q := by
  let : MetricSpace P := metricSpace hc hq
  apply LipschitzWith.of_dist_le_mul
  intro x y
  change dist (q x) (q y) ≤ (1 : ℝ) * chartChainDist cell q x y
  simpa only [NNReal.coe_one, one_mul] using ambient_le hc (q := q) x y

/-- Any map into a single cell, isometric in the ambient metric, stays
isometric after equipping the source with its intrinsic chain metric. -/
theorem isometry_into_cell {A : Type z} [MetricSpace A]
    (hq : Function.Injective q) (i : ι) (e : A → P)
    (he : ∀ x, e x ∈ cell i) (hisom : Isometry (q ∘ e)) :
    let : MetricSpace P := metricSpace hc hq
    Isometry e := by
  let : MetricSpace P := metricSpace hc hq
  apply Isometry.of_dist_eq
  intro x y
  change chartChainDist cell q (e x) (e y) = dist x y
  rw [on_cell hc i (he x) (he y)]
  exact hisom.dist_eq x y

end BrehmApprox.ConnectedCellMetric
